# The rhoai overlay passes --metrics-cert-path (manager_patch.yaml). That flag
# is ODH-only: upstream feast-dev/feast does not define it, so no
# quay.io/feastdev/feast-operator release can accept it. Pin the downstream
# build of this repository, by digest so the deployment is reproducible.
# Digests are bumped with the rhoai release, like the images below.
RELATED_IMAGE_FEAST_OPERATOR=quay.io/opendatahub/feast-operator@sha256:9109cca784747ebd829236799366116be560acfd3dfdbc2a965d1525e190160b
RELATED_IMAGE_FEATURE_SERVER=quay.io/feastdev/feature-server:0.68.0
RELATED_IMAGE_CRON_JOB=registry.redhat.io/openshift4/ose-cli@sha256:bc35a9fc663baf0d6493cc57e89e77a240a36c43cf38fb78d8e61d3b87cf5cc5
RELATED_IMAGE_ODH_KUBE_RBAC_PROXY_IMAGE=quay.io/rhoai/odh-kube-rbac-proxy-rhel9@sha256:840104f3469c04edc40e5b42b3b797367f5cac55cef76fb9563f4f766e479e4f
# Set at deploy time by the Open Data Hub operator from GatewayConfig (external OIDC).
OIDC_ISSUER_URL=
