# The rhoai overlay passes --metrics-cert-path (manager_patch.yaml), so this pin
# must be a release that defines that flag. 0.68.0 does not: the manager exits
# at flag parsing with "flag provided but not defined: -metrics-cert-path".
# Bump this pin once a release defines the flag. Do not move the mount to the
# controller-runtime default directory to hide the version skew.
RELATED_IMAGE_FEAST_OPERATOR=quay.io/feastdev/feast-operator:0.68.0
RELATED_IMAGE_FEATURE_SERVER=quay.io/feastdev/feature-server:0.68.0
RELATED_IMAGE_CRON_JOB=registry.redhat.io/openshift4/ose-cli@sha256:bc35a9fc663baf0d6493cc57e89e77a240a36c43cf38fb78d8e61d3b87cf5cc5
RELATED_IMAGE_ODH_KUBE_RBAC_PROXY_IMAGE=quay.io/rhoai/odh-kube-rbac-proxy-rhel9@sha256:840104f3469c04edc40e5b42b3b797367f5cac55cef76fb9563f4f766e479e4f
# Set at deploy time by the Open Data Hub operator from GatewayConfig (external OIDC).
OIDC_ISSUER_URL=
